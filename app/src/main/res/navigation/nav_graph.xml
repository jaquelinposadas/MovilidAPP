<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_saved">

    <fragment
        android:id="@+id/navigation_saved"
        android:name="com.example.movilidapp.SavedRoutesFragment"
        android:label="Rutas guardadas"
        tools:layout="@layout/fragment_saved_routes" />

    <fragment
        android:id="@+id/navigation_nearby"
        android:name="com.example.movilidapp.NearbyRoutesFragment"
        android:label="Rutas cercanas"
        tools:layout="@layout/fragment_nearby_routes" />

    <fragment
        android:id="@+id/navigation_help"
        android:name="com.example.movilidapp.HelpFragment"
        android:label="Ayuda"
        tools:layout="@layout/fragment_help">
        <action
            android:id="@+id/action_navigation_help_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.movilidapp.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat" />
</navigation>